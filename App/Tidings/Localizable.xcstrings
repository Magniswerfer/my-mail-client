    "Tidings connects directly to iCloud over IMAP. Your mail stays on this Mac and with Apple.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidings forbinder direkte til iCloud via IMAP. Din mail bliver på denne Mac og hos Apple."
          }
        }
      }
    },
    "Use your primary @icloud.com address, not a custom-domain address. You can send from custom domains later.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug din primære @icloud.com-adresse, ikke en adresse på eget domæne. Du kan sende fra egne domæner senere."
          }
        }
      }
    },
    "Create an app-specific password at account.apple.com →": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en app-specifik adgangskode på account.apple.com →"
          }
        }
      }
    },
