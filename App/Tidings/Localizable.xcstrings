    "Describe the rule": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv reglen"
          }
        }
      }
    },
    "Move mail about shoes from shops to Advertising": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt mail om sko fra butikker til Reklamer"
